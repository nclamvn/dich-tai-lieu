# =============================================================================
# Security Settings (P0 — MUST configure before production deployment)
# =============================================================================

# Environment: development | internal | production
SECURITY_MODE=development

# Session secret — MUST change in production!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=INSECURE-DEV-SECRET-CHANGE-IN-PRODUCTION

# Session backend: memory (dev) | file (persists across restarts)
SESSION_BACKEND=memory
SESSION_FILE_PATH=data/sessions.json

# Session timeout in hours
SESSION_TIMEOUT_HOURS=8

# Enable session auth (required for production)
SESSION_AUTH_ENABLED=false

# CSRF secret — MUST change if CSRF is enabled
CSRF_SECRET_KEY=INSECURE-DEV-CSRF-CHANGE-IN-PRODUCTION
CSRF_ENABLED=false

# CORS origins (comma-separated). Empty = dev defaults (localhost:*)
# Production example: CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=

# Rate limiting for auth endpoints (prevent brute force)
AUTH_RATE_LIMIT=5/minute

# =============================================================================
# API Keys
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
GOOGLE_API_KEY=your-google-gemini-api-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Translation Config
PROVIDER=openai
MODEL=gpt-4o-mini
QUALITY_MODE=balanced
CONCURRENCY=4

# --- Per-provider model registry (override model IDs without code changes) ---
# Defaults track the newest family; set these to refresh models as they evolve.
ANTHROPIC_TEXT_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_VISION_MODEL=claude-sonnet-4-5-20250929
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
DEEPSEEK_TEXT_MODEL=deepseek-chat
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash

# --- Translation determinism, caching & reliability (live core_v2 path) ---
# Low temperature => faithful, low-variance translation (was provider default ~1.0)
TRANSLATION_TEMPERATURE=0.3
# Anthropic prompt caching of the static system prefix (cuts input tokens 30-50%)
TRANSLATION_PROMPT_CACHE_ENABLED=true
# Bump to invalidate all chunk-cache entries after a prompt/algorithm change
TRANSLATION_PROMPT_VERSION=v2
# --- Covers (áp bìa khi xuất PDF/DOCX/EPUB) ---
# Template bìa mặc định khi caller không truyền per-job. Ids lấy từ
# GET /api/cover-templates (classic, minimal, bold, noir, gradient, duotone,
# geometric, framed, colorblock, academic, vintage, emblem). Rỗng = không bìa.
# COVER_TEMPLATE=noir
# Ảnh bìa riêng (đường dẫn trong uploads/) — THẮNG cover_template khi cả hai có.
# COVER_IMAGE=uploads/covers/my_cover.png

# --- JWT (auth /api/auth/*) ---
# BẮT BUỘC cho production — boot-guard TỪ CHỐI KHỞI ĐỘNG khi SECURITY_MODE=production
# mà biến này trống hoặc <32 ký tự (nếu bỏ trống, khóa sinh ngẫu nhiên lúc khởi
# động: mọi JWT mất hiệu lực sau mỗi restart và khác nhau giữa các worker).
# Sinh khóa: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=change-me-64-random-chars

# --- Metrics (/metrics cho Prometheus) ---
# Đặt → scraper phải gửi "Authorization: Bearer <token>" (mọi mode).
# Trống → /metrics mở ở development, TẮT (403) ở production (fail-closed —
# bảng path/latency/error là bản đồ trinh sát bề mặt API).
# METRICS_TOKEN=

# API-key auth cho service-to-service (xem docs/PRODUCTION_CHECKLIST.md)
# API_KEY_AUTH_ENABLED=false

# Database backend (sqlite mặc định; CI đặt tường minh)
# DATABASE_BACKEND=sqlite
# --- Terminology ledger (auto-glossary + explicit glossaries) ---
# Auto-extract per-document terms/proper nouns and inject them into the cached
# system prompt so terminology stays consistent across every chunk
TRANSLATION_AUTO_GLOSSARY_ENABLED=true
# Max terms rendered into the prompt terminology block (highest priority first)
TRANSLATION_GLOSSARY_MAX_TERMS=80
# Comma-separated explicit glossary IDs to load (empty = none); these outrank auto terms
TRANSLATION_GLOSSARY_IDS=
# Per-chunk retry budget before the job fails loudly (no silent [ERROR] holes)
TRANSLATION_MAX_RETRIES=4
TRANSLATION_BACKOFF_BASE=2.0
TRANSLATION_BACKOFF_CAP=60.0
# Seconds a provider stays benched after a transient failure (was: whole process)
PROVIDER_HEALTH_TTL_SECONDS=300
# --- Bounded repair pass: re-translate only quality-gate-flagged suspect chunks ---
# Adopt a retry only when it is strictly better; off => translation behavior unchanged
TRANSLATION_REPAIR_ENABLED=true
# Max suspect chunks a single job will repair (bounds extra cost/latency)
TRANSLATION_REPAIR_MAX_CHUNKS=20
# --- Optional semantic faithfulness pass feeding the repair loop (opt-in LLM check) ---
# Judge whether each deterministically-clean chunk faithfully renders its source;
# unfaithful ones join the SAME repair loop. Off => no extra LLM calls, repair unchanged
TRANSLATION_SEMANTIC_VERIFY_ENABLED=false
# Max chunks a single job semantically checks (bounds cost)
TRANSLATION_SEMANTIC_VERIFY_MAX=30
# --- Rolling cross-chunk context (deterministic; LLM-free by default) ---
# Older chunks feeding each chunk's rolling-context gist for translation
TRANSLATION_CONTEXT_WINDOW=3
# Optional LLM summary pre-pass to enrich the gist (off => no extra API calls)
TRANSLATION_CONTEXT_SUMMARY_ENABLED=false
# --- Translation Memory reuse (read/hints path) ---
# Inject approved TM translations as prompt hints (no-op when TM empty/unavailable)
TM_REUSE_ENABLED=true
# Max approved TM hints prepended to a chunk's prompt
TM_MAX_HINTS=5
# In-client rate-limit backoff before failing over to the next provider
PROVIDER_RATE_LIMIT_RETRIES=4
PROVIDER_BACKOFF_BASE=2.0
PROVIDER_BACKOFF_CAP=60.0

# Chunk Settings
CHUNK_SIZE=3000
CONTEXT_WINDOW=500
MAX_RETRIES=5
RETRY_DELAY=3
# Hard per-chunk token budget: no semantic chunk exceeds this estimate_tokens
# count (structure-preserving split). Feeds core_v2 SemanticChunker.
CHUNK_MAX_TOKENS=2000

# File Upload Limits
MAX_UPLOAD_SIZE_MB=50
MAX_OCR_IMAGE_SIZE_MB=10

# Rate Limiting
# Format: "number/period" (e.g., "60/minute", "100/hour", "1000/day")
# Rate limiting is auto-ON in production, OFF in dev/tests. RATE_LIMIT is the global
# per-user/IP backstop applied by SlowAPIMiddleware; per-route limits are tighter.
# RATE_LIMIT_ENABLED forces enforcement on/off regardless of SECURITY_MODE.
# RATE_LIMIT_ENABLED=true
RATE_LIMIT=240/minute

# Feature Flags
CACHE_ENABLED=true
QUALITY_VALIDATION=true
QUALITY_THRESHOLD=0.7
GLOSSARY_ENABLED=true
GLOSSARY_NAME=default

# Phase 5.1: Chunk Cache (Translation Layer Caching)
CHUNK_CACHE_ENABLED=true
CHUNK_CACHE_TTL_DAYS=30

# Phase 5.2: Checkpoints (Fault-Tolerant Resume)
CHECKPOINT_ENABLED=true
CHECKPOINT_INTERVAL=10

# Phase 5.4: Multi-Format Streaming Pipeline (Memory Optimization + Live Preview)
# Supports DOCX, PDF, and TXT formats with incremental building
STREAMING_ENABLED=true
STREAMING_BATCH_SIZE=100
STREAMING_BROADCAST_CHUNKS=true
STREAMING_PARTIAL_EXPORT=true
STREAMING_MEMORY_LIMIT_MB=500

# Export Settings
EXPORT_FORMAT=docx
EXPORT_ADD_HEADER=true
EXPORT_ADD_FOOTER=true
EXPORT_ADD_PAGE_NUMBERS=true
EXPORT_WATERMARK=false
EXPORT_WATERMARK_TEXT=DRAFT

# OCR Settings (Hybrid System - optional)
# MathPix API (for formula-specialized OCR)
MATHPIX_APP_ID=your-mathpix-app-id
MATHPIX_APP_KEY=your-mathpix-app-key

# PaddleOCR Settings (local OCR, no API key needed)
PADDLE_LANG=en
OCR_BACKEND=auto

# Deprecated (will be removed)
# DEEPSEEK_OCR_API_URL=
# DEEPSEEK_OCR_API_KEY=

# PDF Processing
POPPLER_PATH=

# ============================================================================
# BOOK-TO-CINEMA: VIDEO AI PROVIDERS
# ============================================================================

# ---------- Google Veo 2 (Recommended - Google Ecosystem) ----------
# Get from: https://console.cloud.google.com
# 1. Enable Vertex AI API
# 2. Create service account with Vertex AI User role
# 3. Download JSON key file
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
VEO_LOCATION=us-central1

# ---------- Replicate (Alternative/Fallback) ----------
# Get from: https://replicate.com/account/api-tokens
# Supports: minimax/video-01, hunyuan-video, stable-video-diffusion
REPLICATE_API_TOKEN=r8_your-replicate-api-token-here

# ---------- Runway Gen-3 (Future Support) ----------
# Get from: https://runwayml.com/api
# RUNWAY_API_KEY=your-runway-api-key-here

# ============================================================================
# CINEMA PIPELINE SETTINGS
# ============================================================================

# Default video provider: veo, replicate
CINEMA_DEFAULT_PROVIDER=veo

# Minimum video duration per scene (seconds)
CINEMA_MIN_VIDEO_DURATION=30

# Maximum concurrent video renders
CINEMA_MAX_CONCURRENT_RENDERS=3

# Output directory for cinema jobs
CINEMA_OUTPUT_DIR=outputs/cinema

# Default style: blockbuster, anime, noir, documentary, fantasy, horror, romantic
CINEMA_DEFAULT_STYLE=blockbuster

# ============================================================================
# WEBSOCKET FAN-OUT ACROSS WORKERS (#6 Pha 1)
# ============================================================================
# Empty = local-only broadcast (single worker; current/default behaviour).
# Set to a Redis URL to fan out job-progress WebSocket events across workers,
# so a client connected to one worker sees progress for a job running on
# another. Required before running uvicorn with --workers > 1. The SAME Redis
# powers #6 Pha 1 (WS fan-out), Pha 2 (global concurrency limit) and Pha 3
# (cross-worker cancel) — all now implemented. To scale out: set this, then
# raise --workers. Empty (default) = local-only single-worker, unchanged.
WS_REDIS_URL=
WS_PUBSUB_CHANNEL=aps:events

